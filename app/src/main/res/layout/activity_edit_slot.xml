<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F8F9FA">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edit Slot"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#0D47A1"
        android:layout_marginBottom="24dp"/>

    <EditText
        android:id="@+id/etEditSlotTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Time (e.g. 10:00 AM)"
        android:minHeight="48dp"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etEditSlotDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Date (e.g. 12 Oct)"
        android:minHeight="48dp"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnUpdateSlot"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Save Changes"
        android:backgroundTint="#0D47A1"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnUnbookSlot"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Cancel Student Booking"
        android:backgroundTint="#FFA000"
        android:textColor="#FFFFFF"/>

</LinearLayout>